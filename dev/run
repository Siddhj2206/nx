#!/usr/bin/env bash
# Runs a command in nx's dev container (dev/Containerfile), with the
# repository at the same path and cargo's caches in a named volume.
#   dev/run cargo test
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
image=localhost/nx-dev:45
podman image exists "$image" || podman build -t "$image" "$repo/dev"
tty=(); [[ -t 0 ]] && tty=(-it)
exec podman run --rm "${tty[@]}" --security-opt label=disable \
	-v "$repo:$repo" -w "$PWD" \
	-v nx-dev-cargo:/cargo -v nx-dev-target:/target \
	-e CARGO_TERM_COLOR -e NO_COLOR \
	"$image" "$@"
