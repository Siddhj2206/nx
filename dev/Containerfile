# nx's build environment: the image's own Fedora release, so nx links against
# the same glibc and libsolv it runs with (design: Linking).
ARG FEDORA=45
FROM quay.io/fedora/fedora:${FEDORA}
RUN dnf -y install --setopt=install_weak_deps=False \
        rust cargo clippy rustfmt gcc clang-devel \
        libsolv-devel libsolv-tools rpm-devel zstd \
        bindgen-cli ShellCheck git-core \
    && dnf clean all
ENV CARGO_HOME=/cargo CARGO_TARGET_DIR=/target
