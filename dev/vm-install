#!/usr/bin/env bash
# Builds nx, nxd and nx-shim in the dev container and installs them, their
# units, the polkit files and the PATH snippets into the Neptuno test VM (`vm
# start` first). Never the daily driver. /usr is read-only in the VM, so
# binaries go to /usr/local/bin (nx-shim to /usr/local/libexec/nx), units,
# the polkit rule and the sh snippet to /etc, and the polkit action file and
# the fish snippet by bind-mounting a copy of their directories (until the next
# reboot: run this again).
#   dev/vm-install
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
vm=${NX_VM:-$HOME/.local/share/nx-vm/vm}
"$repo/dev/run" cargo build --release
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
podman run --rm --security-opt label=disable -v nx-dev-target:/target:ro -v "$out:/out" \
	localhost/nx-dev:45 cp /target/release/nx /target/release/nxd /target/release/nx-shim /out/
"$vm" cp "$out/nx" "$out/nxd" "$out/nx-shim" "$repo"/systemd/*.* "$repo"/systemd/user/nx-notify.* \
	"$repo"/polkit/* "$repo"/shell/* \
	"$repo/dev/vm-test.rules"
# The script below runs in the VM: its $unit is not ours to expand.
# shellcheck disable=SC2016
"$vm" ssh 'set -e
install -m755 nx nxd /usr/local/bin/
install -Dm755 nx-shim /usr/local/libexec/nx/nx-shim
install -m644 nx.sh /etc/profile.d/nx.sh
install -Dm644 60-nx.conf /etc/environment.d/60-nx.conf
# The units name /usr/bin; the VM keeps the binaries in /usr/local/bin.
sed "s|/usr/bin/nxd|/usr/local/bin/nxd|" nxd@.service > /etc/systemd/system/nxd@.service
install -m644 nxd.socket /etc/systemd/system/
for unit in nx-select.service nx-settle.service nx-sync.service nx-refresh.service nx-upgrade.service; do
	sed "s|/usr/bin/nx|/usr/local/bin/nx|" "$unit" > "/etc/systemd/system/$unit"
done
install -m644 nx-refresh.timer nx-upgrade.timer /etc/systemd/system/
mkdir -p /etc/systemd/user
sed "s|/usr/bin/nx|/usr/local/bin/nx|" nx-notify.service > /etc/systemd/user/nx-notify.service
install -m644 nx-notify.path /etc/systemd/user/
mkdir -p /etc/sysusers.d /etc/tmpfiles.d
install -m644 nx.sysusers /etc/sysusers.d/nx.conf
install -m644 nx.tmpfiles /etc/tmpfiles.d/nx.conf
install -m644 50-nx.rules /etc/polkit-1/rules.d/
install -m644 vm-test.rules /etc/polkit-1/rules.d/49-nx-vm-test.rules
usermod -aG wheel tester
if ! mountpoint -q /usr/share/polkit-1/actions; then
	rm -rf /run/nx-actions && mkdir /run/nx-actions
	cp -a /usr/share/polkit-1/actions/. /run/nx-actions/
	mount --bind /run/nx-actions /usr/share/polkit-1/actions
fi
install -m644 org.nx.policy /usr/share/polkit-1/actions/
# A bootc image'"'"'s fish reads /usr/etc/fish and vendor_conf.d, never /etc/fish.
fish=/usr/share/fish/vendor_conf.d
if ! mountpoint -q $fish; then
	rm -rf /run/nx-fish && mkdir /run/nx-fish
	cp -a $fish/. /run/nx-fish/
	mount --bind /run/nx-fish $fish
fi
install -m644 nx.fish $fish/
systemd-sysusers /etc/sysusers.d/nx.conf
systemd-tmpfiles --create /etc/tmpfiles.d/nx.conf
systemctl daemon-reload
systemctl enable --now nxd.socket
systemctl enable nx-select.service nx-settle.service nx-sync.service nx-refresh.timer nx-upgrade.timer
systemctl --global enable nx-notify.path nx-notify.service
systemctl restart polkit'
