# nx's state directory. setgid keeps new files in group nx; the default ACL
# lets wheel users (who may activate generations without a password, see the
# polkit rule) write state too. nxd, not tmpfiles, creates
# /var/lib/extensions/nx: the link must be absent while the prefix backend is
# in use. Installed as /usr/lib/tmpfiles.d/nx.conf.
#Type Path                     Mode  User Group Age Argument
d      /var/lib/nx             2775  nx   nx    -
d      /var/lib/nx/generations 2775  nx   nx    -
d      /var/lib/nx/store       2775  nx   nx    -
d      /var/lib/nx/keys        2775  nx   nx    -
# Not recursive: it runs every boot, and the store is large. New files and
# directories inherit the default entries.
a+     /var/lib/nx             -     -    -     -   group:wheel:rwx,default:group:wheel:rwx,default:group:nx:rwx
a+     /var/lib/nx/generations -     -    -     -   group:wheel:rwx,default:group:wheel:rwx,default:group:nx:rwx
a+     /var/lib/nx/store       -     -    -     -   group:wheel:rwx,default:group:wheel:rwx,default:group:nx:rwx
a+     /var/lib/nx/keys        -     -    -     -   group:wheel:rwx,default:group:wheel:rwx,default:group:nx:rwx
