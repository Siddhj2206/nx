// An administrator at the machine may change the host tier without a
// password: the active local session of a user in wheel. Everyone else
// falls through to org.nx.policy (administrator authentication).
polkit.addRule(function(action, subject) {
    if (action.id == "org.nx.activate" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
